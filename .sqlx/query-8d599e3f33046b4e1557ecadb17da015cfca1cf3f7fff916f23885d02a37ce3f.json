  "query": "\n                    SELECT \n                        id, \n                        email, \n                        first_name, \n                        last_name, \n                        role as \"role: Role\", \n                        created_at as \"created_at!\", \n                        updated_at as \"updated_at!\"\n                    FROM users\n                    WHERE role = $1\n                    ORDER BY created_at DESC\n                    LIMIT $2 OFFSET $3\n                    ",
